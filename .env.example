# San Martino — esempio variabili d'ambiente per esecuzione locale.
# Copia in `.env` (gia' nel .gitignore) e adatta i path.
# Per IntelliJ: usare il plugin EnvFile, oppure copiare le variabili nella
# Run Configuration. .env non viene letto automaticamente da Spring Boot.

# --- Datasource overrides (default puntano gia' ai container docker-compose) ---
# EVENTS_DB_URL=jdbc:postgresql://localhost:5433/events
# STANDS_DB_URL=jdbc:postgresql://localhost:5434/stands
# SAGA_DB_URL=jdbc:postgresql://localhost:5435/saga

# --- Kafka ---
# KAFKA_BOOTSTRAP=localhost:9092

# --- Firebase Cloud Messaging (notifications-service) ---
# Path ASSOLUTO al service-account.json di Firebase. NON metterlo nel repo.
# Suggerito: ~/.sanmartino/firebase-service-account.json (fuori dal repo).
# Se sanmartino.fcm.enabled=false (default), il path puo' restare vuoto:
# il LoggingPushNotificationSender stub resta attivo.
FCM_CREDENTIALS=C:/Users/<your-user>/.sanmartino/firebase-service-account.json
