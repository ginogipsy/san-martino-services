// Grafana Alloy — raccolta log dei pod e spedizione a Loki. Sostituisce
// Promtail (end-of-life dal 2 marzo 2026, vedi docs/observability.md) e
// produce le stesse label, così la dashboard e le query LogQL non cambiano:
//
//   {job="sanmartino", service="<servizio>", level="<livello>"}  i sei servizi (JSON ECS)
//   {job="kubernetes", service="<app>"}                         tutto il resto (Kafka, Postgres…)
//
// I log arrivano dall'API di Kubernetes, non dai file del nodo: leggere
// /var/log/pods richiederebbe un volume hostPath, che il profilo Pod Security
// `restricted` del namespace vieta. Così Alloy gira come un pod qualunque, non
// root, con un Role di sola lettura sul proprio namespace.

discovery.kubernetes "pods" {
	role = "pod"

	namespaces {
		own_namespace = true
	}
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		target_label  = "service"
	}

	rule {
		target_label = "job"
		replacement  = "kubernetes"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_component"]
		regex         = "backend"
		target_label  = "job"
		replacement   = "sanmartino"
	}

	// Distingue i container dello stesso pod (vault e seed); per i servizi è
	// sempre `app`.
	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}
}

loki.source.kubernetes "pods" {
	targets    = discovery.relabel.pods.output
	forward_to = [loki.process.ecs.receiver]
}

// Solo i log dei sei servizi sono JSON (ECS): gli altri passano intatti.
loki.process "ecs" {
	stage.match {
		selector = "{job=\"sanmartino\"}"

		// `@` è un token riservato di JMESPath: il nome del campo va fra apici.
		stage.json {
			expressions = {
				level     = "log.level",
				timestamp = "\"@timestamp\"",
			}
		}

		// SOLO label a bassa cardinalità, come nel compose: correlationId,
		// operation e durationMs restano campi della riga, filtrabili con
		// `| json | correlationId="…"`.
		stage.labels {
			values = {
				level = "",
			}
		}

		stage.timestamp {
			source = "timestamp"
			format = "RFC3339Nano"
		}
	}

	forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
